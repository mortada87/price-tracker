# Copy this file to `.env` and fill in the values you need.
# All variables are optional — the backend boots fine without them, but you
# won't get LLM extraction or external notifications until they're set.

# Port the backend listens on (default: 3000).
PORT=3000

# Shared secret guarding `/api/*`. STRONGLY recommended when exposing the
# server publicly (e.g. via ngrok). When empty, auth is disabled.
# Generate one with: `node -e "console.log(crypto.randomBytes(24).toString('base64url'))"`
#
# Clients authenticate either with `?token=<value>` or `Authorization: Bearer <value>`.
# In the React app you set the token once by visiting
#     https://<your-host>/#token=<value>
# — the frontend saves it to localStorage and strips the hash.
ACCESS_TOKEN=

# Anthropic API key — required only when strategy="llm" and backend="anthropic".
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# ── Alert channels ──────────────────────────────────────────────────────────
# Configure one or both. Each configured channel receives the alert in
# parallel; channels with empty creds are silently skipped.

# Slack — Incoming Webhook URL for the channel you want alerts in.
# 1. In Slack, click the channel name → Integrations → Add an app → search
#    "Incoming WebHooks" → Add to Slack.
# 2. Pick the channel, click Add Integration, copy the Webhook URL below.
#    It looks like: https://hooks.slack.com/services/T0000/B0000/xxxxxxxx
SLACK_WEBHOOK_URL=

# Telegram bot credentials.
# 1. Talk to @BotFather on Telegram, run `/newbot`, copy the token below.
# 2. Send any message to your new bot, then visit
#    https://api.telegram.org/bot<TOKEN>/getUpdates to find your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
